{
  "name": "@deepseek-ai/dsh-client-ui-skin-internet-angel-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Non-commercial pastel pixel desktop fan skin for DSH Web",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Small-tailqwq/dsh-internet-angel-desktop.git"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./skin.json": "./skin.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "skin.json",
    "skin.build.json",
    "preview",
    "assets/ATTRIBUTION.md",
    "README.md",
    "NOTICE.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "theme",
        "sessions",
        "workspaces"
      ],
      "platform": "web"
    }
  },
  "dshClient": {
    "inject": [
      "theme",
      "sessions",
      "workspaces"
    ],
    "platform": "web"
  },
  "scripts": {
    "build": "tsdown",
    "build:manifest": "node scripts/write-skin-build.mjs . Small-tailqwq/dsh-internet-angel-desktop",
    "watch": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "license": "UNLICENSED",
  "peerDependencies": {
    "cordis": "^4.0.0-rc.7"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "cordis": "^4.0.0-rc.7",
    "jsdom": "29.1.1",
    "lightningcss": "^1.32.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@10.33.2"
}
